#!/usr/bin/env python3
"""Persistent HDR/10-bit profiles for the installer's Lua Hyprland sessions."""
import argparse
import fcntl
import os
from pathlib import Path
import shutil
import subprocess
import sys
import tempfile

BEGIN = '-- BEGIN FEDORA-POSTINSTALL DISPLAY'
END = '-- END FEDORA-POSTINSTALL DISPLAY'
LOADER = '''do
    local root = os.getenv("XDG_CONFIG_HOME") or (os.getenv("HOME") .. "/.config")
    dofile(root .. "/fedora-postinstall/display-profile.lua")
end'''


def profile(mode):
    # Wrap before any user/DMS monitor rules load. Partial hl.monitor() calls
    # replace entire rules, so adding a final color-only rule would lose layout.
    enabled = mode == 'on'
    return f'''-- fedora-display profile: {mode}
-- Generated by fedora-display. Original monitor/config tables are never mutated.
local function copy(t)
    local result = {{}}
    for k, v in pairs(t) do result[k] = v end
    return result
end
local monitor = hl.monitor
hl.monitor = function(settings)
    local result = copy(settings)
    result.bitdepth = {10 if enabled else 8}
    result.cm = "{'auto' if enabled else 'srgb'}"
    {'-- HDR capability detection stays with the monitor/driver.' if enabled else 'result.supports_hdr = -1'}
    return monitor(result)
end
local config = hl.config
hl.config = function(settings)
    local result = copy(settings)
    result.render = copy(settings.render or {{}})
    result.render.cm_auto_hdr = {1 if enabled else 0}
    result.render.send_content_type = {'true' if enabled else 'false'}
    return config(result)
end
hl.config({{}})
'''


def merge(text, enabled):
    if BEGIN in text or END in text:
        if text.count(BEGIN) != 1 or text.count(END) != 1 or text.index(BEGIN) > text.index(END):
            raise ValueError('Niejednoznaczny blok DISPLAY; konfiguracja pozostaje bez zmian.')
        start, stop = text.index(BEGIN), text.index(END) + len(END)
        # Only remove the exact block and separator we generate.
        if text[stop:stop+2] == '\n\n':
            stop += 2
        text = text[:start] + text[stop:]
    return f'{BEGIN}\n{LOADER}\n{END}\n\n' + text if enabled else text


def atomic_write(path, data, mode=0o600):
    if path.is_symlink():
        raise ValueError(f'Odmowa zastąpienia dowiązania: {path}')
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, temp = tempfile.mkstemp(prefix='.' + path.name + '.', dir=path.parent)
    try:
        with os.fdopen(fd, 'wb') as output:
            output.write(data)
            os.fchmod(output.fileno(), mode)
        os.replace(temp, path)
    finally:
        if os.path.exists(temp):
            os.unlink(temp)


def run(*args, env=None):
    result = subprocess.run(args, env=env, capture_output=True, text=True, timeout=40)
    if result.returncode:
        raise RuntimeError(f'{args[0]}: {result.stderr.strip() or result.stdout.strip()}')
    return result.stdout.strip()


def verify(config, main_text, profile_text):
    with tempfile.TemporaryDirectory(prefix='fedora-display-') as temp:
        root = Path(temp)
        staged = root / 'config'
        shutil.copytree(config / 'hypr', staged / 'hypr', symlinks=True)
        (staged / 'hypr/hyprland.lua').write_text(main_text)
        if profile_text is not None:
            target = staged / 'fedora-postinstall/display-profile.lua'
            target.parent.mkdir(parents=True)
            target.write_text(profile_text)
        # Match shell selection used by Lua configs without copying user secrets.
        shell = config / 'fedora-postinstall/shell'
        if shell.is_file():
            target = staged / 'fedora-postinstall/shell'
            target.parent.mkdir(parents=True, exist_ok=True)
            shutil.copyfile(shell, target)
        runtime = root / 'runtime'
        runtime.mkdir(mode=0o700)
        env = dict(os.environ, XDG_CONFIG_HOME=str(staged), XDG_RUNTIME_DIR=str(runtime), HYPRLAND_NO_RT='1')
        for key in ('HYPRLAND_INSTANCE_SIGNATURE', 'WAYLAND_DISPLAY'):
            env.pop(key, None)
        output = run('Hyprland', '--verify-config', '--config', str(staged / 'hypr/hyprland.lua'), env=env)
        if 'config ok' not in output.lower():
            raise RuntimeError('Hyprland nie potwierdził poprawności konfiguracji:\n' + output)


def reload_config():
    run('hyprctl', 'reload')
    errors = run('hyprctl', 'configerrors')
    if errors:
        raise RuntimeError(errors)


def change(config, state, mode):
    main = config / 'hypr/hyprland.lua'
    target = config / 'fedora-postinstall/display-profile.lua'
    for path in (main, target):
        if path.is_symlink():
            raise ValueError(f'Odmowa zastąpienia dowiązania: {path}')
    if not main.is_file():
        raise ValueError('Brak hypr/hyprland.lua. Komenda wymaga konfiguracji Lua Hyprland >=0.55.')
    old_main = main.read_bytes()
    old_profile = target.read_bytes() if target.exists() else None
    main_mode = main.stat().st_mode & 0o777
    proposed = merge(old_main.decode(), mode != 'reset')
    new_profile = profile(mode) if mode != 'reset' else None
    active = bool(os.environ.get('HYPRLAND_INSTANCE_SIGNATURE'))
    if active and run('hyprctl', 'configerrors'):
        raise RuntimeError('Najpierw napraw istniejące błędy hyprctl configerrors.')
    verify(config, proposed, new_profile)
    backup = Path(tempfile.mkdtemp(prefix='display-', dir=state))
    (backup / 'hyprland.lua').write_bytes(old_main)
    if old_profile is not None:
        (backup / 'display-profile.lua').write_bytes(old_profile)
    try:
        # Install the module before its loader. On reset remove loader first.
        if new_profile is not None:
            atomic_write(target, new_profile.encode())
        atomic_write(main, proposed.encode(), main_mode)
        if new_profile is None and target.exists():
            target.unlink()
        if active:
            reload_config()
    except Exception:
        if old_profile is not None:
            atomic_write(target, old_profile)
        atomic_write(main, old_main, main_mode)
        if old_profile is None and target.exists():
            target.unlink()
        if active:
            try:
                reload_config()
            except (RuntimeError, OSError, subprocess.SubprocessError) as error:
                print(f'Ponowne wczytanie przywróconej konfiguracji: {error}', file=sys.stderr)
        raise
    print({'off': 'HDR wyłączony, SDR/sRGB, kolor 8-bit; automatyczne przełączanie profilu wyłączone.',
           'on': 'Włączono 10-bit i automatyczne HDR dla aplikacji fullscreen (jeśli sprzęt obsługuje).',
           'reset': 'Przywrócono oryginalne ustawienia monitora i renderowania.'}[mode])
    print(f'Kopia konfiguracji: {backup}')
    if not active:
        print('Ustawienie zadziała przy następnym logowaniu do Hyprlanda.')


def selected(config):
    path = config / 'fedora-postinstall/display-profile.lua'
    if path.is_file():
        lines = path.read_text().splitlines()
        line = lines[0] if lines else ''
        for mode in ('on', 'off'):
            if line == f'-- fedora-display profile: {mode}':
                return mode
        raise ValueError(f'Nieznany format profilu: {path}')
    return 'reset'


def main():
    parser = argparse.ArgumentParser(description='Trwałe przełączanie HDR i 10-bit w Hyprlandzie (bez sudo).')
    parser.add_argument('action', choices=('install', 'off', 'on', 'toggle', 'status', 'reset'))
    args = parser.parse_args()
    if os.geteuid() == 0:
        raise ValueError('Uruchom jako użytkownik pulpitu, bez sudo.')
    config = Path(os.environ.get('XDG_CONFIG_HOME', str(Path.home() / '.config')))
    if args.action == 'install':
        destination = Path.home() / '.local/bin/fedora-display'
        atomic_write(destination, Path(__file__).read_bytes(), 0o755)
        print(f'Zainstalowano: {destination}\nUruchom: {destination} off')
        return
    if args.action == 'status':
        print('Zapisany profil: ' + selected(config) + ' (reset = własna konfiguracja)')
        if os.environ.get('HYPRLAND_INSTANCE_SIGNATURE'):
            print(run('hyprctl', 'monitors'))
        return
    state = Path(os.environ.get('XDG_STATE_HOME', str(Path.home() / '.local/state'))) / 'fedora-postinstall'
    state.mkdir(parents=True, exist_ok=True)
    with (state / 'display.lock').open('w') as lock:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        mode = args.action
        if mode == 'toggle':
            mode = 'on' if selected(config) == 'off' else 'off'
        change(config, state, mode)


if __name__ == '__main__':
    try:
        main()
    except (OSError, ValueError, RuntimeError, subprocess.SubprocessError) as error:
        print(f'fedora-display: {error}', file=sys.stderr)
        sys.exit(1)
