text
lang en_US.UTF-8
keyboard us
timezone Europe/Warsaw --utc
network --bootproto=dhcp --device=link --activate
liveimg --url=file:///run/kde-live/LiveOS/squashfs.img
rootpw --lock
user --name=tester --groups=wheel --password=$6$rZdRUb3kFwQIDkiw$X8k0FU1GWiVAGVWXVZgyxQp6xDTudZHKuqqmX8y.khtct0O.m8r9q7.L2NhDL.F6uzO9Ze/PL9lfMvqZ.v/Ib/ --iscrypted
sshkey --username=tester "@@SSH_PUBLIC_KEY@@"
firewall --enabled --service=ssh
selinux --enforcing
services --enabled=sshd,NetworkManager
bootloader --location=mbr --append="console=ttyS0,115200n8"
zerombr
clearpart --all --initlabel --drives=vda
autopart --type=btrfs
reboot
%pre --erroronfail
set -eu
mkdir -p /run/kde-live
mount -o ro -L Fedora-KDE-Live-44 /run/kde-live
%end
%post --erroronfail
set -eu
rpm -q openssh-server
printf 'tester ALL=(ALL) NOPASSWD: ALL\nDefaults:tester verifypw=never\n' > /etc/sudoers.d/90-vm-test
chmod 440 /etc/sudoers.d/90-vm-test
systemctl set-default multi-user.target
%end
